# SpeechBridge configuration.
#
# There is no API key here, and there cannot be: this tenant force-applies
# disableLocalAuth=true to every Cognitive Services account (see docs/adr/0002).
# Authentication is Microsoft Entra ID — run `az login` locally, or attach a
# managed identity when deployed. Nothing in this file is a secret.

# The resource's custom-subdomain endpoint. Entra auth does not work on the
# regional (*.api.cognitive.microsoft.com) host — the custom subdomain is required.
SPEECH_ENDPOINT=https://speechbridge27252.cognitiveservices.azure.com

# The region the resource lives in. Used for the audio WebSocket endpoints.
SPEECH_REGION=eastus2

# Port for the token broker.
PORT=8787
