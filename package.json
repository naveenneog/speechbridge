{
  "name": "speech-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Near-realtime bidirectional speech translation over Azure AI Speech, with keyless Entra ID auth.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:voices": "tsx scripts/verify-voices.ts",
    "verify:browser": "node scripts/browser-check.mjs",
    "fixture:speech": "node scripts/make-fixture.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "bench:synthesis": "node scripts/bench-synthesis.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "express": "5.2.1",
    "microsoft-cognitiveservices-speech-sdk": "1.51.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^9.2.4",
    "eslint": "9.39.5",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}



